datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

model Song {
  id          String     @id @default(uuid())
  title       String
  artist      String
  album       String?
  durationMs  Int
  playlists   Playlist[]
  coverUrl    String?

  @@index([title])
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  songs     Song[]
  isPublic  Boolean  @default(true)
}
